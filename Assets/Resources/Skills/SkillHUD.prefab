  m_Options:
    m_Options:
    - m_Text: 手動のみ／追加条件なし
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: 使用可能になったら
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: 自分の体力％以下
      m_Image: {fileID: 0}
